FROM arm64v8/ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# --- [0] Locale and base tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    locales software-properties-common curl gnupg2 ca-certificates && \
    locale-gen en_US en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# --- [1] Enable universe (required for ROS)
RUN add-apt-repository universe

# --- [2] Install ROS 2 apt source via fixed version
RUN export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F\" '{print $4}') && \
    curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo $VERSION_CODENAME)_all.deb" && \
    dpkg -i /tmp/ros2-apt-source.deb && \
    rm /tmp/ros2-apt-source.deb && \
    apt-get update

# --- [3] Add Xilinx and Lely PPAs
# Retried: add-apt-repository fetches each PPA's signing key from Launchpad,
# which intermittently answers HTTP 500 with GPGKeyTemporarilyNotFoundError and
# fails the whole build. Observed on k26-jazzy while k26-humble passed the same
# step on the same runner minutes earlier, so it is server-side and transient.
RUN for ppa in xilinx-apps/xilinx-drivers ubuntu-xilinx/gstreamer xilinx-apps/ppa; do \
        ok=0; \
        for i in 1 2 3 4 5; do \
            if add-apt-repository -y "ppa:$ppa"; then ok=1; break; fi; \
            echo "add-apt-repository ppa:$ppa failed (attempt $i/5), retrying in $((i * 20))s"; \
            sleep $((i * 20)); \
        done; \
        [ "$ok" = 1 ] || exit 1; \
    done && \
    apt-get update

# --- [4-8] Install ROS and dependencies
RUN apt-get install -y --no-install-recommends \
    git wget unzip build-essential cmake g++ gcc pkg-config python3-pip \
    python3-colcon-common-extensions python3-vcstool python3-rosdep 

RUN apt-get install -y --no-install-recommends \
    libgstreamer-plugins-base1.0-dev libgstreamer-plugins-good1.0-dev libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-libav \
    libyuv-dev gstreamer1.0-tools 

RUN apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros-base 

RUN apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-pluginlib ros-${ROS_DISTRO}-rclcpp ros-${ROS_DISTRO}-sensor-msgs   

RUN apt-get install -y gcc-aarch64-linux-gnu g++-aarch64-linux-gnu

RUN rm -rf /var/lib/apt/lists/*

# --- [9] Init rosdep
RUN rosdep init || true && rosdep update

# --- [10] Set OpenCV environment variables globally
ENV OpenCV_DIR=/opt/install/lib/cmake/opencv4
ENV LD_LIBRARY_PATH=/opt/install/lib

# --- [11] Build opencv from source
RUN cd /tmp && \
    git clone https://github.com/opencv/opencv_contrib.git --branch=4.5.0 && \
    git clone https://github.com/opencv/opencv.git --branch=4.5.0

RUN cd /tmp/opencv && \
    mkdir build && \
    cd build && \
    cmake -D CMAKE_BUILD_TYPE=RELEASE \
          -D CMAKE_INSTALL_PREFIX=/opt/install \
          -D CMAKE_SYSTEM_NAME=Linux \
          -D CMAKE_SYSTEM_PROCESSOR=aarch64 \
          -D CMAKE_C_COMPILER=aarch64-linux-gnu-gcc \
          -D CMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ \
          -D OPENCV_EXTRA_MODULES_PATH=../../opencv_contrib/modules \
          -D BUILD_EXAMPLES=OFF \
          -D BUILD_TESTS=OFF .. && \
    make -j4

RUN cd /tmp/opencv/build && \
    rm -rf /opt/install/* && \
    make install && \
    ldconfig

# --- [12] Clean up OpenCV source files
RUN rm -rf /tmp/opencv /tmp/opencv_contrib

# --- [13] Install additional dependencies
RUN apt-get update && apt-get install -y nlohmann-json3-dev \
    ros-${ROS_DISTRO}-vision-msgs ros-${ROS_DISTRO}-v4l2-camera ros-${ROS_DISTRO}-pluginlib \
    ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-std-srvs ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-cv-bridge

RUN rm -rf /var/lib/apt/lists/*