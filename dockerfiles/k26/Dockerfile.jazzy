FROM arm64v8/ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# --- Locale and base tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    locales \
    software-properties-common \
    curl \
    gnupg2 \
    lsb-release \
    ca-certificates \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# --- Enable universe (required for ROS)
RUN add-apt-repository universe && apt-get update && rm -rf /var/lib/apt/lists/*

# --- Add ROS 2 repository using official method
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | \
    gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | \
    tee /etc/apt/sources.list.d/ros2.list > /dev/null

# --- Add Xilinx PPAs
RUN add-apt-repository -y ppa:xilinx-apps/xilinx-drivers && \
    add-apt-repository -y ppa:ubuntu-xilinx/gstreamer && \
    add-apt-repository -y ppa:ubuntu-xilinx/sdk && \
    apt-get update && rm -rf /var/lib/apt/lists/*

# --- Install ROS and core development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    unzip \
    build-essential \
    cmake \
    g++ \
    gcc \
    pkg-config \
    python3-pip \
    python3-colcon-common-extensions \
    python3-vcstool \
    python3-rosdep \
    ros-dev-tools \
    && rm -rf /var/lib/apt/lists/*

# --- Install GStreamer dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-good1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    libyuv-dev \
    gstreamer1.0-tools \
    && rm -rf /var/lib/apt/lists/*

# --- Install ROS base and packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros-base \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-pluginlib \
    ros-${ROS_DISTRO}-rclcpp \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-vision-msgs \
    ros-${ROS_DISTRO}-v4l2-camera \
    ros-${ROS_DISTRO}-std-srvs \
    nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*

# --- Install cross-compilation toolchain
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# --- Init rosdep
RUN rosdep init || true && rosdep update

# --- Set OpenCV environment variables globally
ENV OpenCV_DIR=/opt/install/lib/cmake/opencv4
ENV LD_LIBRARY_PATH=/opt/install/lib

# --- Build opencv from source
RUN cd /tmp && \
    git clone https://github.com/opencv/opencv_contrib.git --branch=4.10.0 --depth 1 && \
    git clone https://github.com/opencv/opencv.git --branch=4.10.0 --depth 1 && \
    cd /tmp/opencv && \
    mkdir build && \
    cd build && \
    cmake -D CMAKE_BUILD_TYPE=RELEASE \
          -D CMAKE_INSTALL_PREFIX=/opt/install \
          -D CMAKE_SYSTEM_NAME=Linux \
          -D CMAKE_SYSTEM_PROCESSOR=aarch64 \
          -D CMAKE_C_COMPILER=aarch64-linux-gnu-gcc \
          -D CMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ \
          -D OPENCV_EXTRA_MODULES_PATH=../../opencv_contrib/modules \
          -D BUILD_EXAMPLES=OFF \
          -D BUILD_TESTS=OFF \
          -D BUILD_PERF_TESTS=OFF \
          -D BUILD_opencv_apps=OFF \
          -D BUILD_DOCS=OFF .. && \
    make -j$(nproc) && \
    rm -rf /opt/install/* && \
    make install && \
    ldconfig && \
    cd / && \
    rm -rf /tmp/opencv /tmp/opencv_contrib

# --- Set working directory
WORKDIR /root

# --- Source ROS setup in bashrc for interactive use
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
