FROM arm32v7/ubuntu:jammy

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy

# --- Locale, base tools, and repositories (single layer)
RUN apt-get update && apt-get install -y --no-install-recommends \
    locales software-properties-common curl gnupg2 ca-certificates && \
    locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 && \
    add-apt-repository universe && \
    apt-get update && \
    rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8

# --- Install build dependencies
# NOTE: Jammy ships Python 3.10 and gcc 11. Some Jazzy packages may require
# newer compilers — add gcc-12 g++-12 and update-alternatives if needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget unzip build-essential cmake g++ gcc pkg-config python3-pip \
    python3-dev python3-numpy libeigen3-dev libtinyxml2-dev \
    libssl-dev libasio-dev libboost-all-dev apt-utils \
    libacl1-dev liblttng-ust-dev && \
    pip3 install \
        colcon-common-extensions vcstool rosdep lark && \
    rm -rf /var/lib/apt/lists/*

# --- Set OpenCV environment variables globally
ENV OpenCV_DIR=/opt/install/lib/cmake/opencv4
ENV LD_LIBRARY_PATH=/opt/install/lib

# --- Build OpenCV from source
RUN cd /tmp && \
    git clone https://github.com/opencv/opencv_contrib.git --branch=4.13.0 --depth 1 && \
    git clone https://github.com/opencv/opencv.git --branch=4.13.0 --depth 1 && \
    cd /tmp/opencv && mkdir build && cd build && \
    cmake -D CMAKE_BUILD_TYPE=RELEASE \
          -D CMAKE_INSTALL_PREFIX=/opt/install \
          -D OPENCV_EXTRA_MODULES_PATH=../../opencv_contrib/modules \
          -D BUILD_EXAMPLES=OFF \
          -D BUILD_TESTS=OFF \
          -D BUILD_PERF_TESTS=OFF \
          -D BUILD_DOCS=OFF .. && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    rm -rf /tmp/opencv /tmp/opencv_contrib

# --- Prepare ROS 2 source tree
RUN rosdep init && rosdep update

COPY extra.repos.jazzy /tmp/extra.repos

RUN mkdir -p /tmp/ros2_${ROS_DISTRO}/src && \
    cd /tmp/ros2_${ROS_DISTRO} && \
    vcs import --input https://raw.githubusercontent.com/ros2/ros2/${ROS_DISTRO}/ros2.repos src && \
    vcs import --input /tmp/extra.repos src

RUN cd /tmp/ros2_${ROS_DISTRO} && \
    rosdep install --from-paths src --ignore-src --rosdistro ${ROS_DISTRO} -y \
    --skip-keys "libopencv-dev libopencv-contrib-dev libopencv-imgproc-dev python3-opencv fastcdr rti-connext-dds-6.0.1 urdfdom_headers" || true

# Helper script to keep colcon invocations DRY
RUN printf '#!/bin/bash\ncd /tmp/ros2_${ROS_DISTRO} && \\\n\
colcon build \\\n\
    --merge-install --install-base /opt/ros/${ROS_DISTRO} \\\n\
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DOpenCV_DIR=/opt/install/lib/cmake/opencv4 \\\n\
    --packages-up-to "$@" && \\\n\
rm -rf /tmp/ros2_${ROS_DISTRO}/build /tmp/ros2_${ROS_DISTRO}/log\n' \
    > /usr/local/bin/ros-build && chmod +x /usr/local/bin/ros-build

# ============================================================
# Phase 1: ros_base equivalent
#   - rclcpp/rclpy + all rcl/rmw core deps
#   - all common interfaces (std_msgs, geometry_msgs, sensor_msgs, nav_msgs, etc.)
#   - ros2cli + all sub-commands (topic, node, service, param, action, component)
#   - launch + launch_ros
#   - pluginlib + class_loader
# ============================================================
RUN ros-build \
        rclcpp \
        rclpy \
        ros2cli \
        launch_ros \
        pluginlib \
        class_loader \
        std_msgs \
        geometry_msgs \
        sensor_msgs \
        nav_msgs \
        action_msgs \
        diagnostic_msgs \
        shape_msgs \
        trajectory_msgs \
        visualization_msgs

# ============================================================
# Phase 2: RMW layer
# ============================================================
RUN ros-build rmw_cyclonedds_cpp

# ============================================================
# Phase 3: Remaining ros_base packages
#   - CLI sub-commands (ros2topic, ros2node, ros2service, etc.)
#   - Launch extras (launch_xml, launch_yaml, launch_testing)
#   - TF2 / geometry2
#   - URDF / robot model
#   - Rosbag2
#   - Security (sros2)
#   - Missing common interfaces (std_srvs, stereo_msgs, actionlib_msgs)
# ============================================================
RUN ros-build \
        ros2topic \
        ros2node \
        ros2service \
        ros2param \
        ros2action \
        ros2run \
        ros2launch \
        ros2component \
        ros2pkg \
        ros2interface \
        ros2doctor \
        ros2lifecycle \
        ros2multicast \
        ros2plugin \
        launch_xml \
        launch_yaml \
        launch_testing \
        launch_testing_ros \
        tf2_ros \
        tf2_geometry_msgs \
        tf2_sensor_msgs \
        tf2_eigen \
        tf2_tools \
        kdl_parser \
        urdf \
        robot_state_publisher \
        ros2bag \
        rosbag2_transport \
        sros2 \
        std_srvs \
        stereo_msgs \
        actionlib_msgs \
        rclcpp_action \
        rclcpp_lifecycle

# ============================================================
# Phase 4: Extra packages — edit freely, phases 1-3 stay cached
# ============================================================
RUN ros-build \
        cv_bridge \
        image_transport \
        demo_nodes_cpp \
        examples_rclcpp_minimal_client \
        examples_rclcpp_minimal_publisher \
        examples_rclcpp_minimal_service \
        examples_rclcpp_minimal_subscriber \
        examples_rclcpp_minimal_timer

# Clean up source tree and build helper
RUN rm -rf /tmp/ros2_${ROS_DISTRO} /tmp/extra.repos /usr/local/bin/ros-build

# --- Set ROS environment variables
ENV AMENT_PREFIX_PATH=/opt/ros/${ROS_DISTRO}
ENV COLCON_PREFIX_PATH=/opt/ros/${ROS_DISTRO}
ENV LD_LIBRARY_PATH=/opt/install/lib:/opt/ros/${ROS_DISTRO}/lib
ENV PATH=/opt/ros/${ROS_DISTRO}/bin:$PATH
ENV PYTHONPATH=/opt/ros/${ROS_DISTRO}/lib/python3.10/site-packages
ENV ROS_DISTRO=${ROS_DISTRO}
ENV ROS_VERSION=2
ENV ROS_PYTHON_VERSION=3

WORKDIR /root
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc
